{
	"schemaVersion": 1,
	"id": "armorcemcompat",
	"version": "${version}",
	"name": "Armor CEM Compat",
	"description": "Hace que los packs de armadura 3D (CEM) dejen de romper la armadura de los mods. Aporta la propiedad armor_item a los .properties de EMF/ETF y trae un pack de compatibilidad integrado.",
	"authors": [
		"Maguet"
	],
	"contact": {},
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.maguet.armorcemcompat.ArmorCemCompat"
		]
	},
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"entity_texture_features": "*",
		"fabric-resource-loader-v0": "*"
	},
	"recommends": {
		"entity_model_features": "*"
	},
	"mixins": [
		"armorcemcompat.mixins.json"
	]
}
